# Базовый URL бэкенда CIS.PR (без слэша в конце).
#
# ВАЖНО для cookie-аутентификации: фронт и бэк должны быть на ОДНОМ
# родительском домене, иначе httpOnly refresh-cookie не работает.
#   Прод:     https://api.cispr.app   (фронт на cispr.app)
#   Локально: http://localhost:8000
#
# На хостинге фронта (Render static site) эту переменную надо задать в
# Environment — Vite зашивает её в бандл при сборке.
VITE_API_URL=http://localhost:8000
